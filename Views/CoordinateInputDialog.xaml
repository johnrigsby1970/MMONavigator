<controls:ChildWindow x:Class="MMONavigator.Views.CoordinateInputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MMONavigator.Helpers"
             xmlns:controls="clr-namespace:MMONavigator.Controls"
             Title="Enter Coordinates" Height="260" Width="380" 
             WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
             Background="#2D2D30" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Prompt Header -->
        <TextBlock x:Name="PromptLabel" Text="Enter point coordinates:" 
                   FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>

        <!-- System & Handedness Context Warning -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                BorderBrush="#3F3F46" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="SystemInfoLabel" Text="Coordinate System: Right-Handed (x z y)" 
                           Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="HintLabel" 
                           Text="Tip: You can paste full strings (e.g., '120.5, 45.0, 10.2') directly into either box below." 
                           Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Explicit X and Y Inputs -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="X Coordinate:" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="XTextBox" Style="{StaticResource MainTextBoxStyle}"
                         helpers:ClickThroughBehavior.IsEnabled="True" Padding="4"
                         TextChanged="CoordinateTextBox_TextChanged" KeyDown="InputTextBox_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Y Coordinate:" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="YTextBox" Style="{StaticResource MainTextBoxStyle}"
                         helpers:ClickThroughBehavior.IsEnabled="True" Padding="4"
                         TextChanged="CoordinateTextBox_TextChanged" KeyDown="InputTextBox_KeyDown"/>
            </StackPanel>
        </Grid>

        <!-- Dynamic Output Preview -->
        <TextBlock x:Name="PreviewTextBlock" Grid.Row="3" VerticalAlignment="Center" 
                   HorizontalAlignment="Center" Foreground="#888888" FontSize="11"
                   Text="Parsed: X=0, Y=0"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"
                    Style="{StaticResource MainButtonStyle}"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"
                    Style="{StaticResource MainButtonStyle}"/>
        </StackPanel>
    </Grid>
</controls:ChildWindow>