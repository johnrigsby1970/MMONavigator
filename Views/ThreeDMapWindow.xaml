            Margin="20">

    <!-- Hint Subtitle Container -->
    <Border Background="#252526"
            BorderBrush="#3E3E42"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24"
            HorizontalAlignment="Center">

        <StackPanel>
            <!-- Main Header -->
            <TextBlock Text="GETTING STARTED"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <!-- Subtitle -->
            <TextBlock Text="Load a zone map to start tracking your character in 3D."
                       FontSize="12"
                       Foreground="#9CDCFE"
                       TextAlignment="Center"
                       Margin="0,0,0,16" />

            <Separator Background="#3E3E42" Margin="0,0,0,16" />

            <!-- Steps Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Step 1 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="1." Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Use the 2D map tool to set up your zone image first." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                
                <!-- Step 2 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="2." Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Go to File → Add Map to World and select your map image." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                
                <!-- Step 3 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="3." Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Designate the Z coordinate (elevation) matching a known element or mob." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Step 4 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="4." Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Save your newly created World configuration." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                
                <!-- Step 5 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="5." Foreground="Gold" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Start tracking via your game macro and choose Navigation → Re-center Camera." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
            </Grid>

            <!-- Tip Box -->
            <Border Background="#1E1E1E"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
