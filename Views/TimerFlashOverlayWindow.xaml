<Window x:Class="MMONavigator.Views.TimerFlashOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer Flash Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Fade Out Animation Storyboard -->
        <Storyboard x:Key="FlashFadeStoryboard" Completed="Storyboard_Completed">
            <DoubleAnimation Storyboard.TargetName="FlashBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0.0" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Outer Perimeter Flash Border -->
    <Border x:Name="FlashBorder"
            BorderBrush="Gold"
            BorderThickness="4"
            CornerRadius="4"
            Background="#25FFD700"
            Opacity="0">
        <!-- Optional Inner Accent Line -->
        <Border BorderBrush="White" BorderThickness="1" CornerRadius="2" Margin="1"/>
    </Border>
</Window>