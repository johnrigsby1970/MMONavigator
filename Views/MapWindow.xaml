                    <!--     <Run -->
                    <!--         Text=" macro running as you move. Your current location becomes the center of this new map. Where you walk defines open space, while hitting boundaries creates walls. You can draw and walk the edge of a wall to draw a line representing the wall, or river, or ridge line. Use different brush colors for edges and roads. The map expands as you move to the edge as long as you are running the macro. You can go out of bounds." /> -->
                    <!-- </TextBlock> -->

                    <Border Background="#1E1E1E" 
        BorderBrush="#3E3E42" 
        BorderThickness="1" 
        CornerRadius="6" 
        Padding="16,12" 
        MaxWidth="440">
    <StackPanel>
        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="💡 How Draw Mode Works" FontSize="13" FontWeight="Bold" Foreground="White"/>
        </StackPanel>

        <!-- Requirements / Quick Action -->
        <TextBlock FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10">
            Keep your <Run FontWeight="Bold" Foreground="Gold">/loc</Run> macro running continuously. If it stops, restart it before moving again. You are the brush. Your movement draws on the map.
        </TextBlock>

        <Separator Background="#3E3E42" Margin="0,0,0,10"/>

        <!-- Key Rules -->
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bullet 1 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,0,0,6">
                To prevent a stale starting point, your current location has been cleared. Start tracking your movement, /loc, to begin drawing. The map will configure itself based on starting point.
            </TextBlock>
            
            <!-- Bullet 1 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,0,0,6">
                You start out in the center of the map. Your initial location coordinates define the center. The map automatically expands as you move toward the edges.
            </TextBlock>

            <!-- Bullet 2 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,0,0,6">
                Trace walls, rivers, or ridges to outline boundaries.
            </TextBlock>

            <!-- Bullet 3 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap">
                Use different brush colors for distinct terrain types like edges, walls, and roads.
            </TextBlock>
            
            <!-- Bullet 4 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap">
                Movement will normally drop period circles where you stand. If you want a line, choose the line option. It will connect the last location if you start tracking /loc again. Switch to transparent to avoid bad lines after restarting movement.
            </TextBlock>
            
            <!-- Bullet 5 -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="•" Foreground="Gold" FontWeight="Bold"/>
            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap">
                Once the map is saved, you can stop and restart drawing by re-entering draw mode off the menu.
            </TextBlock>
        </Grid>
    </StackPanel>
</Border>
                    <TextBlock FontSize="11.5"
                               Foreground="#888888"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0">
                        Tip: Switch to the <Run Foreground="White">Transparent (∅)</Run> color to pause drawing without stopping your macro.
                    </TextBlock>
                </StackPanel>

            </StackPanel>

            <!-- Watermark Layer -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}"
                        IsHitTestVisible="False"
                        MaxWidth="500"
                        Margin="20">

                <!-- Large Header -->
                <TextBlock Text="LOAD MAP"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="LightGray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- Hint Subtitle -->
                <Border Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel>
                        <!-- Large Header -->
                        <TextBlock Text="LOAD A ZONE MAP"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="LightGray"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                        <!-- Subtitle -->
                        <TextBlock Text="To track your character, import an image of the zone map you want to explore."
                                   FontSize="12"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   Margin="0,0,0,16" />

                        <Separator Background="#3E3E42" Margin="0,0,0,16" />

                        <!-- Steps -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="1." Foreground="Gold" FontWeight="Bold"
                                       Margin="0,0,8,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="Take a screenshot of a map online, or download one. Your game likely has a fan resource. The map should be to scale, with two coordinate points of reference. Size will not matter."
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            
                            <!-- Step 2 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="1." Foreground="Gold" FontWeight="Bold"
                                       Margin="0,0,8,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="Open the screenshot in an image editor and crop out any pieces you don't want, like a browser address bar."
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            
                            <!-- Step 3 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="1." Foreground="Gold" FontWeight="Bold"
                                       Margin="0,0,8,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="Go to File → New Map from Image File... and select the image to use as your map."
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Step 4 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="2." Foreground="Gold" FontWeight="Bold"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="Set two calibration points using in-game coordinates so your position syncs automatically."
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
                        </Grid>

                        <!-- Tip / Shortcut Box -->
                        <Border Background="#1E1E1E"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🗺️ " FontSize="12" VerticalAlignment="Center" Foreground="#888888" />
                                <TextBlock Text="Tip: Already configured a map? Use File → Open Saved Map..."
                                           FontSize="11"
                                           Foreground="#888888"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
        <!-- Opacity Slider -->
        <Border Grid.Row="4"
                Style="{StaticResource MainBorderStyle}"
                Padding="10,5,10,5"
                Visibility="{Binding UIVisibility}" Focusable="False">

            <StackPanel Orientation="Horizontal" Focusable="False">
                <TextBlock Text="Opacity" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"
                           Focusable="False" />
                <Slider Width="100" Minimum="0.1" Maximum="1.0" Value="{Binding Opacity}" VerticalAlignment="Center"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" Focusable="False">
                    <Slider.Style>
                        <Style TargetType="Slider">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}"
                                            Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>

                <!-- General Status TextBlock: Hidden during either calibration step -->
                <TextBlock x:Name="StatusTextBlock" Foreground="White" VerticalAlignment="Center" Margin="20,0,10,0"
                           Text="Status: Ready" Focusable="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- Hide when Step 1 is active -->
                                <DataTrigger Binding="{Binding Path=IsCalibratingStep1, RelativeSource={RelativeSource AncestorType={x:Type local:MapWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                
                                <!-- Hide when Step 2 is active -->
                                <DataTrigger Binding="{Binding Path=IsCalibratingStep2, RelativeSource={RelativeSource AncestorType={x:Type local:MapWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <!-- Step 1 Instruction -->
                <TextBlock Text="CALIBRATION: 1st calibration point. Left click on a point on the map and enter its coordinates."
                           FontSize="10"
                           Foreground="Gold" VerticalAlignment="Center" Margin="20,0,10,0"
                           Visibility="{Binding Path=IsCalibratingStep1, RelativeSource={RelativeSource AncestorType={x:Type local:MapWindow}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Step 2 Instruction -->
                <TextBlock Text="CALIBRATION: 2nd calibration point. Left click on a point on the map, some distance from the 1st, and enter its coordinates."
                           FontSize="10"
                           Foreground="Gold" VerticalAlignment="Center" Margin="20,0,10,0"
                           Visibility="{Binding Path=IsCalibratingStep2, RelativeSource={RelativeSource AncestorType={x:Type local:MapWindow}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</controls:ChildWindow>