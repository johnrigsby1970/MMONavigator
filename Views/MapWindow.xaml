            <Rectangle Width="18" Height="18"
                       Fill="{Binding EffectiveTransparentBrush}"
                       Visibility="{Binding UIVisibility}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       IsHitTestVisible="False" />


            <!-- Watermark Layer -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="500"
                        Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition
                                        Binding="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}"
                                        Value="Collapsed" />
                                    <Condition Binding="{Binding Settings.IsCalibrated}" Value="False" />
                                    <Condition Binding="{Binding IsDrawModeActive}" Value="False" />
                                    <Condition Binding="{Binding IsCalibrationTipDismissed}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="NOT CALIBRATED"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="Gold"
                           Opacity="0.4"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="0,0,0,8" />

                <Border Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Grid>
                        <Button Content="✕"
                                Command="{Binding DismissCalibrationTipCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="22"
                                Height="22"
                                Margin="0,-10,-10,0"
                                Foreground="#888888"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                ToolTip="Close Notice">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="11">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                                Value="#33FFFFFF" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <StackPanel>
                            <TextBlock Text="MAP NOT CALIBRATED"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="Gold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />

                            <TextBlock
                                Text="This image needs to be aligned with game coordinates before real-time position tracking can begin."
                                FontSize="12"
                                Foreground="#CCCCCC"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                LineHeight="16"
                                Margin="0,0,0,16" />

                            <Separator Background="#3E3E42" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="1." Foreground="Gold" FontWeight="Bold"
                                           Margin="0,0,8,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="Click the 'Calibrate' button in the top menu bar."
                                           Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="2." Foreground="Gold" FontWeight="Bold"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="Pick two spots on the map and type in your in-game /loc coordinates for each."
                                           Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
                            </Grid>

                            <Border Background="#1E1E1E"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🎯 " FontSize="12" VerticalAlignment="Center" Foreground="Gold" />
                                    <TextBlock Text="Tip: Choose two points far apart on the map for maximum accuracy."
                                               FontSize="11"
                                               Foreground="#888888"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Watermark Layer -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        MaxWidth="500"
                        Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <!-- Default to Collapsed -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Show ONLY when: Map IS loaded AND it is NOT calibrated AND Draw Mode IS active -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <!-- NullToVisibilityConverter returns Collapsed when MapImage is NOT null -->
                                    <Condition
                                        Binding="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}"
                                        Value="Collapsed" />
                                    <Condition Binding="{Binding Settings.IsCalibrated}" Value="False" />
                                    <Condition Binding="{Binding IsDrawModeActive}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Large Header -->
                <TextBlock Text="DRAW MODE"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="LightGray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <!-- Hint Subtitle -->
                <StackPanel MaxWidth="460" Margin="10">
                    <TextBlock Text="You are centered on a new map."
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextAlignment="Center"
                               Margin="0,0,0,8" />

                    <!-- <TextBlock FontSize="12" -->
                    <!--            Foreground="#B0B0B0" -->
                    <!--            LineHeight="18" -->
                    <!--            TextAlignment="Center" -->
